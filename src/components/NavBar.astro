---
import LanguageSwitcher from './LanguageSwitcher.astro';

const primaryLinks = [
  { href: '/',                              key: 'nav.home'              },
  { href: '/tools/timelapse',               key: 'nav.timelapse'         },
  { href: '/tools/baumportraets',           key: 'nav.baumportraets'     },
  { href: '/tools/hoehenveraenderung',      key: 'nav.hoehenveraenderung'},
];

const moreLinks = [
  { href: '/tools/geodaten',  key: 'nav.geodaten'  },
  { href: '/ressourcen',      key: 'nav.ressourcen' },
];
---

<header class="navbar" id="navbar">
  <div class="navbar__inner container">
    <!-- Brand wordmark (small, links home) -->
    <a href="/" class="navbar__brand" aria-label="Dendromat Startseite">
      <img src="/logo/dendromat.svg" alt="Dendromat" class="navbar__brand-logo" width="40" height="36" />
      <span class="navbar__brand-name">Dendromat</span>
    </a>

    <!-- Hamburger toggle (mobile) -->
    <button
      class="navbar__hamburger"
      id="nav-toggle"
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="Navigation öffnen"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Navigation links -->
    <nav id="nav-menu" class="navbar__nav" role="navigation">
      <ul class="navbar__links" role="list">
        {primaryLinks.map(link => (
          <li>
            <a href={link.href} class="navbar__link" data-i18n={link.key}>
              {link.key === 'nav.home'               && 'Start'}
              {link.key === 'nav.timelapse'          && 'Timelapse Creator'}
              {link.key === 'nav.baumportraets'      && 'Baumarten­porträts'}
              {link.key === 'nav.hoehenveraenderung' && 'Vegetationshöhen-Veränderungskarte'}
            </a>
          </li>
        ))}

        <!-- "Mehr" dropdown -->
        <li class="navbar__dropdown-wrap">
          <button class="navbar__link navbar__more-btn" id="more-toggle" aria-expanded="false" data-i18n="nav.more">
            Mehr <span class="navbar__more-arrow" aria-hidden="true">▾</span>
          </button>
          <ul class="navbar__dropdown" id="more-menu" role="list">
            {moreLinks.map(link => (
              <li>
                <a href={link.href} class="navbar__dropdown-link" data-i18n={link.key}>
                  {link.key === 'nav.geodaten'   && 'Geodaten Downloader'}
                  {link.key === 'nav.ressourcen' && 'Ressourcen'}
                </a>
              </li>
            ))}
          </ul>
        </li>
      </ul>
    </nav>

    <!-- Sound toggle (homepage only, hidden by default) -->
    <button
      id="sound-toggle"
      class="navbar__sound"
      aria-label="Sound einschalten"
      aria-pressed="false"
      style="display:none"
    >
      🔇
    </button>

    <!-- Language switcher (right side) -->
    <div class="navbar__lang">
      <LanguageSwitcher />
    </div>
  </div>
</header>

<style>
  /* -------------------------------------------------------
     Navbar shell
  ------------------------------------------------------- */
  .navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    height: var(--nav-height);
    background: var(--clr-green-dark);
    box-shadow: 0 2px 12px rgba(0,0,0,0.25);
    transition: background 0.3s;
  }

  .navbar.scrolled {
    background: var(--clr-green-deep);
  }

  .navbar__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  /* -------------------------------------------------------
     Brand
  ------------------------------------------------------- */
  .navbar__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .navbar__brand-logo {
    width: 36px;
    height: auto;
    filter: drop-shadow(0 1px 3px rgba(0,0,0,0.3));
  }

  .navbar__brand-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 700;
    font-style: italic;
    color: var(--clr-yellow);
    letter-spacing: -0.02em;
  }

  /* -------------------------------------------------------
     Nav links
  ------------------------------------------------------- */
  .navbar__nav {
    flex: 1;
  }

  .navbar__links {
    display: flex;
    gap: var(--space-md);
    list-style: none;
    align-items: center;
  }

  .navbar__link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--clr-white);
    text-decoration: none;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
  }

  .navbar__link:hover {
    color: var(--clr-yellow);
    border-bottom-color: var(--clr-yellow);
    text-decoration: none;
  }

  .navbar__link.active {
    color: var(--clr-yellow);
    border-bottom-color: var(--clr-yellow-mid);
  }

  /* -------------------------------------------------------
     "Mehr" dropdown button
  ------------------------------------------------------- */
  .navbar__more-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.2rem;
  }

  .navbar__more-arrow {
    font-size: 0.7rem;
    transition: transform 0.15s;
  }

  .navbar__more-btn[aria-expanded="true"] .navbar__more-arrow {
    transform: rotate(180deg);
  }

  /* -------------------------------------------------------
     Dropdown panel
  ------------------------------------------------------- */
  .navbar__dropdown-wrap {
    position: relative;
  }

  .navbar__dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    min-width: 200px;
    background: var(--clr-green-deep);
    border-radius: 8px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.3);
    list-style: none;
    padding: 0.4rem 0;
    z-index: 200;
  }

  .navbar__dropdown.open {
    display: block;
  }

  .navbar__dropdown-link {
    display: block;
    padding: 0.55rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--clr-white);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.1s, color 0.1s;
  }

  .navbar__dropdown-link:hover {
    background: rgba(255,255,255,0.1);
    color: var(--clr-yellow);
    text-decoration: none;
  }

  .navbar__dropdown-link.active {
    color: var(--clr-yellow);
  }

  /* -------------------------------------------------------
     Sound toggle button
  ------------------------------------------------------- */
  .navbar__sound {
    background: none;
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 6px;
    color: var(--clr-white);
    cursor: pointer;
    font-size: 1rem;
    padding: 0.2rem 0.5rem;
    flex-shrink: 0;
    transition: border-color 0.15s, background 0.15s;
  }

  .navbar__sound:hover {
    border-color: var(--clr-yellow);
    background: rgba(255,255,255,0.08);
  }

  /* -------------------------------------------------------
     Language switcher area
  ------------------------------------------------------- */
  .navbar__lang {
    flex-shrink: 0;
    margin-left: auto;
  }

  /* -------------------------------------------------------
     Hamburger (hidden on desktop)
  ------------------------------------------------------- */
  .navbar__hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }

  .navbar__hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--clr-white);
    border-radius: 2px;
    transition: transform 0.25s, opacity 0.25s;
  }

  .navbar__hamburger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .navbar__hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .navbar__hamburger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* -------------------------------------------------------
     Mobile layout
  ------------------------------------------------------- */
  @media (max-width: 768px) {
    .navbar__hamburger {
      display: flex;
      order: 3;
    }

    .navbar__lang {
      order: 2;
      margin-left: auto;
    }

    .navbar__nav {
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: var(--clr-green-deep);
      padding: var(--space-md) var(--space-lg);
      display: none;
      box-shadow: 0 6px 16px rgba(0,0,0,0.3);
    }

    .navbar__nav.open {
      display: block;
    }

    .navbar__links {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .navbar__link {
      font-size: 1rem;
    }

    /* On mobile: flatten the dropdown — always visible inline */
    .navbar__dropdown-wrap {
      width: 100%;
    }

    .navbar__more-btn {
      display: none;
    }

    .navbar__dropdown {
      display: block;
      position: static;
      background: none;
      box-shadow: none;
      border-radius: 0;
      padding: 0;
      min-width: unset;
    }

    .navbar__dropdown-link {
      padding: 0 0 0 0.75rem;
      font-size: 1rem;
      border-left: 2px solid rgba(255,255,255,0.2);
    }
  }
</style>

<script>
  // -------------------------------------------------------
  // Scroll class
  // -------------------------------------------------------
  const navbar = document.getElementById('navbar');
  window.addEventListener('scroll', () => {
    navbar?.classList.toggle('scrolled', window.scrollY > 40);
  }, { passive: true });

  // -------------------------------------------------------
  // Hamburger toggle
  // -------------------------------------------------------
  const toggle  = document.getElementById('nav-toggle');
  const navMenu = document.getElementById('nav-menu');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    navMenu?.classList.toggle('open', !expanded);
  });

  // -------------------------------------------------------
  // "Mehr" dropdown toggle
  // -------------------------------------------------------
  const moreBtn  = document.getElementById('more-toggle');
  const moreMenu = document.getElementById('more-menu');

  moreBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const expanded = moreBtn.getAttribute('aria-expanded') === 'true';
    moreBtn.setAttribute('aria-expanded', String(!expanded));
    moreMenu?.classList.toggle('open', !expanded);
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', () => {
    moreBtn?.setAttribute('aria-expanded', 'false');
    moreMenu?.classList.remove('open');
  });

  // -------------------------------------------------------
  // Active link
  // -------------------------------------------------------
  const path = window.location.pathname;
  document.querySelectorAll('.navbar__link, .navbar__dropdown-link').forEach((link) => {
    const href = link.getAttribute('href');
    if (href && (href === path || (href !== '/' && path.startsWith(href)))) {
      link.classList.add('active');
    }
  });

  // -------------------------------------------------------
  // Sound toggle (homepage only)
  // -------------------------------------------------------
  const soundBtn = document.getElementById('sound-toggle');
  const audio = document.getElementById('bg-audio');

  if (audio && soundBtn) {
    soundBtn.style.display = 'inline-flex';

    soundBtn.addEventListener('click', () => {
      const muted = audio.muted;
      audio.muted = !muted;
      if (audio.muted) {
        soundBtn.textContent = '🔇';
        soundBtn.setAttribute('aria-label', 'Sound einschalten');
        soundBtn.setAttribute('aria-pressed', 'false');
      } else {
        audio.play().catch(() => {});
        soundBtn.textContent = '🔊';
        soundBtn.setAttribute('aria-label', 'Sound ausschalten');
        soundBtn.setAttribute('aria-pressed', 'true');
      }
    });
  }
</script>
